# Checks project-owned C++ for correctness, portability, performance and identifier conventions.
# Dependency headers stay excluded; every project diagnostic is blocking in CI.
Checks: '-*,clang-analyzer-*,bugprone-*,performance-*,portability-*,modernize-use-nullptr,modernize-use-override,readability-identifier-naming'
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(engine|game|sandbox|tools)/'
SystemHeaders: false
FormatStyle: file
CheckOptions:
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.PrivateMemberCase: camelBack
