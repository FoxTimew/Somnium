# Checks project-owned C++ for correctness and consistent identifiers.
# Dependency diagnostics are excluded by their SYSTEM include directories.
Checks: '-*,bugprone-*,performance-*,portability-*,modernize-use-nullptr,modernize-use-override,readability-identifier-naming'
WarningsAsErrors: ''
HeaderFilterRegex: '(engine|game|sandbox)/.*'
CheckOptions:
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.PrivateMemberCase: camelBack
