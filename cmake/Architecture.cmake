# Validates direct Somnium links and their public visibility at configure time.
# The approved acyclic allowlist complements the source include check in CTest.
function(somnium_check_links target public_modules private_modules)
    if(NOT TARGET ${target})
        return()
    endif()
    set(allowed ${public_modules} ${private_modules})
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(links ${target} ${property})
        foreach(link IN LISTS links)
            if(link MATCHES "^\\$<LINK_ONLY:.*>$")
                continue() # Private static linkage is checked in LINK_LIBRARIES.
            endif()
            if(TARGET "${link}")
                get_target_property(aliased "${link}" ALIASED_TARGET)
                if(aliased)
                    set(link "${aliased}")
                endif()
            endif()
            if(link IN_LIST somnium_module_targets)
                if(NOT link IN_LIST allowed)
                    message(FATAL_ERROR "Forbidden module dependency: ${target} -> ${link}")
                endif()
                if(property STREQUAL "INTERFACE_LINK_LIBRARIES" AND NOT link IN_LIST public_modules)
                    message(FATAL_ERROR "Private module exposed publicly: ${target} -> ${link}")
                endif()
            endif()
        endforeach()
    endforeach()
endfunction()

set(somnium_module_targets somnium_core somnium_platform somnium_gpu somnium_renderer
    somnium_assets somnium_scene somnium_input somnium_debug_ui somnium_platform_imgui
    somnium_gpu_imgui somnium_runtime somnium_game sandbox)
somnium_check_links(somnium_core "" "")
somnium_check_links(somnium_platform "somnium_core" "")
somnium_check_links(somnium_gpu "somnium_core;somnium_platform" "")
somnium_check_links(somnium_renderer "somnium_core;somnium_gpu" "")
somnium_check_links(somnium_assets "somnium_core" "")
somnium_check_links(somnium_scene "somnium_core;somnium_assets" "")
somnium_check_links(somnium_input "somnium_core" "somnium_platform")
somnium_check_links(somnium_platform_imgui "" "somnium_platform")
somnium_check_links(somnium_gpu_imgui "" "somnium_gpu")
somnium_check_links(somnium_debug_ui "somnium_core"
    "somnium_platform_imgui;somnium_gpu_imgui;somnium_scene;somnium_input")
somnium_check_links(somnium_runtime "somnium_core;somnium_scene;somnium_input"
    "somnium_platform;somnium_gpu;somnium_renderer;somnium_assets;somnium_debug_ui")
somnium_check_links(somnium_game "somnium_runtime" "")
somnium_check_links(sandbox "" "somnium_game;somnium_runtime")

# Source ownership is checked too: linking the integrations correctly is insufficient
# if an optional backend was accidentally added to a base target's source list.
foreach(module platform gpu)
    get_target_property(base_sources somnium_${module} SOURCES)
    foreach(source IN LISTS base_sources)
        file(TO_CMAKE_PATH "${source}" normalized_source)
        if(normalized_source MATCHES "[Ii][Mm][Gg][Uu][Ii]|(^|/)integration/")
            message(FATAL_ERROR "Optional UI source in somnium_${module}: ${source}")
        endif()
    endforeach()
endforeach()

if(NOT SOMNIUM_ENABLE_DEBUG_UI)
    foreach(target somnium_imgui somnium_platform_imgui somnium_gpu_imgui somnium_debug_ui)
        if(TARGET ${target})
            message(FATAL_ERROR "UI target present with SOMNIUM_ENABLE_DEBUG_UI=OFF: ${target}")
        endif()
    endforeach()
endif()
