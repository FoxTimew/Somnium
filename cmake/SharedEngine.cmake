# Keeps logical module compilation/visibility while linking one iteration engine image.
# Consumer usage interfaces mirror only the original public edges, never private headers.
set(somnium_engine_targets somnium_core somnium_platform somnium_gpu somnium_renderer
    somnium_assets somnium_scene somnium_input somnium_debug_ui somnium_platform_imgui
    somnium_gpu_imgui somnium_runtime)
cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2)
if(BUILD_TESTING)
    add_test(NAME somnium_game_module_link_guard COMMAND "${Python3_EXECUTABLE}"
        "${PROJECT_SOURCE_DIR}/tools/check_game_module.py" "${CMAKE_BINARY_DIR}")
endif()

function(somnium_resolve_alias output item)
    if(TARGET "${item}")
        get_target_property(alias "${item}" ALIASED_TARGET)
        if(alias)
            set(item "${alias}")
        endif()
    endif()
    set(${output} "${item}" PARENT_SCOPE)
endfunction()

foreach(module IN LISTS somnium_engine_targets)
    add_library(${module}_api INTERFACE)
endforeach()
foreach(module IN LISTS somnium_engine_targets)
    target_compile_definitions(${module} PRIVATE SOMNIUM_BUILDING_ENGINE=1)
    set_target_properties(${module} PROPERTIES CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
    foreach(property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
            INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_FEATURES)
        get_target_property(value ${module} ${property})
        if(value)
            set_property(TARGET ${module}_api PROPERTY ${property} "${value}")
        endif()
    endforeach()
    get_target_property(links ${module} INTERFACE_LINK_LIBRARIES)
    foreach(link IN LISTS links)
        if(link MATCHES "^\\$<LINK_ONLY:")
            continue()
        endif()
        somnium_resolve_alias(resolved "${link}")
        if(resolved IN_LIST somnium_engine_targets)
            target_link_libraries(${module}_api INTERFACE ${resolved}_api)
        else()
            target_link_libraries(${module}_api INTERFACE "${link}")
        endif()
    endforeach()
endforeach()

# Engine edits invalidate the local ABI; game edits deliberately do not.
file(GLOB_RECURSE abi_files CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/engine/*.hpp"
    "${PROJECT_SOURCE_DIR}/engine/*.cpp" "${PROJECT_SOURCE_DIR}/engine/*/CMakeLists.txt")
list(APPEND abi_files "${PROJECT_SOURCE_DIR}/CMakeLists.txt"
    "${PROJECT_SOURCE_DIR}/cmake/Dependencies.cmake" "${CMAKE_CURRENT_LIST_FILE}")
list(SORT abi_files)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${abi_files})
set(abi_input "${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_BUILD_TYPE};${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_DEBUG};${CMAKE_CXX_FLAGS_RELEASE};${CMAKE_CXX_FLAGS_RELWITHDEBINFO};${CMAKE_MSVC_RUNTIME_LIBRARY};${CMAKE_OSX_DEPLOYMENT_TARGET};${SOMNIUM_ENABLE_ITERATION};${SOMNIUM_ENABLE_DEBUG_UI};${SOMNIUM_ENABLE_PROFILING};${SOMNIUM_ENABLE_SANITIZERS}")
foreach(path IN LISTS abi_files)
    file(READ "${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 hash "${content}")
    file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${path}")
    string(APPEND abi_input "\n${relative}:${hash}")
endforeach()
string(SHA256 abi_hash "${abi_input}")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/somnium/runtime")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/somnium/runtime/module_build.hpp"
    CONTENT "// Identifies this configured engine, excluding gameplay source changes.\n// Compared before a module factory or any C++ value crosses the boundary.\n#pragma once\n#define SOMNIUM_ENGINE_BUILD_ID \"@abi_hash@\"\n" @ONLY)
target_include_directories(somnium_runtime_api INTERFACE "${CMAKE_BINARY_DIR}/generated")
target_include_directories(somnium_runtime PRIVATE "${CMAKE_BINARY_DIR}/generated")

add_library(somnium_engine_shared SHARED "${PROJECT_SOURCE_DIR}/engine/runtime/src/module_abi.cpp")
somnium_configure_target(somnium_engine_shared)
target_compile_definitions(somnium_engine_shared PRIVATE SOMNIUM_BUILDING_ENGINE=1)
target_include_directories(somnium_engine_shared PRIVATE "${CMAKE_BINARY_DIR}/generated")
set_target_properties(somnium_engine_shared PROPERTIES CXX_VISIBILITY_PRESET hidden
    VISIBILITY_INLINES_HIDDEN YES WINDOWS_EXPORT_ALL_SYMBOLS OFF)
foreach(module IN LISTS somnium_engine_targets)
    target_link_libraries(somnium_engine_shared PRIVATE "$<LINK_LIBRARY:WHOLE_ARCHIVE,${module}>")
    set_property(TARGET somnium_engine_shared PROPERTY LINK_LIBRARY_OVERRIDE_${module} WHOLE_ARCHIVE)
endforeach()

function(somnium_redirect_consumers directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        if(target IN_LIST somnium_engine_targets OR target STREQUAL "somnium_engine_shared"
                OR target MATCHES "_api$")
            continue()
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(links ${target} ${property})
            if(NOT links)
                continue()
            endif()
            set(mapped)
            foreach(link IN LISTS links)
                somnium_resolve_alias(resolved "${link}")
                if(resolved IN_LIST somnium_engine_targets)
                    list(APPEND mapped somnium_engine_shared ${resolved}_api)
                else()
                    list(APPEND mapped "${link}")
                endif()
            endforeach()
            list(REMOVE_DUPLICATES mapped)
            set_property(TARGET ${target} PROPERTY ${property} "${mapped}")
        endforeach()
    endforeach()
    get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(subdirectory IN LISTS subdirectories)
        if(subdirectory MATCHES "^${PROJECT_SOURCE_DIR}/(engine|game|sandbox|tools)(/|$)")
            somnium_redirect_consumers("${subdirectory}")
        endif()
    endforeach()
endfunction()
somnium_redirect_consumers("${PROJECT_SOURCE_DIR}")
install(TARGETS somnium_engine_shared SDL3-shared RUNTIME DESTINATION bin LIBRARY DESTINATION bin)
if(SOMNIUM_ENABLE_PROFILING)
    install(TARGETS TracyClient RUNTIME DESTINATION bin LIBRARY DESTINATION bin)
endif()
